{
  "name": "manager-plus",
  "version": "0.1.0",
  "private": true,
  "description": "Arabic/English desktop POS, stock and accounting for small shops in Egypt (working codename)",
  "license": "UNLICENSED",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node node_modules/electron/install.js && electron-vite dev",
    "build": "electron-vite build",
    "start": "node node_modules/electron/install.js && electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "e2e": "node node_modules/electron/install.js && node e2e/checkout.cjs",
    "dist": "electron-vite build && electron-builder --win nsis --x64 --publish never",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "tauri": "tauri",
    "test:rust": "cargo test --workspace"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@tauri-apps/api": "2.12.5",
    "better-sqlite3": "^13.2.0",
    "multicast-dns": "^7.2.5",
    "qrcode-generator": "2.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "2.12.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "playwright": "1.63.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
