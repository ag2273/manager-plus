{
  "name": "manager-plus",
  "version": "0.1.0",
  "private": true,
  "description": "Arabic/English desktop POS, stock and accounting for shops in Egypt (working codename)",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "npm run build:web && tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "e2e": "node e2e/tauri.mjs target/debug/manager-plus && node e2e/checkout.mjs target/debug/manager-plus",
    "tauri": "tauri",
    "test:rust": "cargo test --workspace"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@tauri-apps/api": "2.12.5",
    "qrcode-generator": "2.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "2.12.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "better-sqlite3": "^13.2.0",
    "eslint": "^10.15.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
